{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "composer install && php artisan config:cache"
  },
  "deploy": {
    "startCommand": "php artisan migrate --force && vendor/bin/heroku-php-apache2 public/",
    "restartPolicyMaxRetries": 5
  }
}
